---
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/projects/{{ project.slug }}/"
eleventyComputed:
  title: "{{ project.name }} - Alexander Key"
  description: "{{ project.metaDescription }}"
---

{% extends "layouts/base.njk" %}

{% block content %}
<article class="mx-auto max-w-2xl px-6 py-16 lg:px-8">
  <a href="/#portfolio" class="text-sm font-semibold text-indigo-600 hover:text-indigo-500">&larr; All projects</a>

  <h1 class="mt-6 text-3xl font-bold tracking-tight text-gray-900">{{ project.name }}</h1>
  <p class="mt-4 text-lg leading-8 text-gray-600">{{ project.intro }}</p>
  <p class="mt-2 text-sm text-gray-500">
    <a href="{{ project.url }}" target="_blank" rel="noopener" class="text-indigo-600 hover:text-indigo-500">{{ project.urlLabel }}</a>
  </p>

  {% for item in project.highlights %}
    <section class="mt-12">
      <h2 class="text-xl font-semibold text-gray-900">{{ item.title }}</h2>
      {% for paragraph in item.body %}
        <p class="mt-3 text-base leading-7 text-gray-600">{{ paragraph }}</p>
      {% endfor %}
    </section>
  {% endfor %}
</article>
{% endblock %}
