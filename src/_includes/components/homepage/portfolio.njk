<div class="bg-white py-10 overflow-x-hidden" id="portfolio">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-base font-semibold leading-7 text-indigo-600">
        Portfolio
      </h2>
      <p
        class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-5xl"
      >
        Projects
      </p>
    </div>
    <p
      class="mx-auto mt-6 max-w-2xl text-center text-lg leading-8 text-gray-600"
    >
      A few Rails apps I've built and shipped to production.
    </p>
    <section class="bg-white">
      <div
        class="py-8 px-4 mx-auto space-y-12 max-w-screen-xl lg:space-y-20 sm:py-16 lg:px-6"
      >
        {% for project in projects %}
          {% set shot = project.screenshots[0] %}
          {% set imageFirst = loop.index is odd %}
          <div
            class="flex flex-col gap-8 items-center lg:grid lg:grid-cols-2 xl:gap-16"
          >
            <div
              class="w-full {% if imageFirst %}order-2 lg:order-1{% else %}order-2{% endif %}"
            >
              {% if shot.frame == "phone" %}
                {% set phoneSrc = shot.src %}
                {% set phoneAlt = shot.alt %}
                {% include "components/phone-frame.njk" %}
              {% elif shot.plain %}
                <a href="/projects/{{ project.slug }}/">
                  <img
                    class="mx-auto w-full max-w-lg lg:max-w-none"
                    src="{{ shot.src }}"
                    width="{{ shot.width }}"
                    height="{{ shot.height }}"
                    alt="{{ shot.alt }}"
                    {% if not loop.first %}loading="lazy"{% endif %}
                  />
                </a>
              {% else %}
                <a href="/projects/{{ project.slug }}/">
                  <img
                    class="w-full rounded-lg shadow-xl ring-1 ring-gray-400/10"
                    src="{{ shot.src }}"
                    width="{{ shot.width }}"
                    height="{{ shot.height }}"
                    alt="{{ shot.alt }}"
                    {% if not loop.first %}loading="lazy"{% endif %}
                  />
                </a>
              {% endif %}
            </div>
            <div
              class="text-gray-500 sm:text-lg {% if imageFirst %}order-1 lg:order-2{% else %}order-1{% endif %}"
            >
              <p class="mb-2 text-sm font-semibold text-indigo-600">
                {{ project.role }} &middot; {{ project.dates }}
              </p>
              <h2
                class="mb-4 text-3xl tracking-tight font-extrabold text-gray-900"
              >
                <a href="/projects/{{ project.slug }}/" class="hover:text-indigo-600">{{ project.name }}</a>
              </h2>
              {% for paragraph in project.summary %}
                <p class="mb-8 font-light lg:text-xl">{{ paragraph }}</p>
              {% endfor %}
              <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                <a
                  href="/projects/{{ project.slug }}/"
                  class="inline-flex items-center gap-1 font-semibold text-indigo-600 hover:text-indigo-500"
                >
                  View project
                  <span aria-hidden="true">&rarr;</span>
                </a>
                <a
                  href="{{ project.siteUrl }}"
                  target="_blank"
                  rel="noopener"
                  class="font-semibold text-gray-900 hover:text-indigo-600"
                >
                  {{ project.urlLabel }}
                </a>
              </div>
            </div>
          </div>
          {% if not loop.last %}<hr />{% endif %}
        {% endfor %}
      </div>
    </section>
  </div>
</div>
